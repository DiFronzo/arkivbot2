# Credentials for the arkivbot2 tool. Copy to .env (gitignored) for local runs,
# or create the same names with `toolforge envvars create NAME` on the tool.
#
# OAuth 1.0a owner-only consumer: https://meta.wikimedia.org/wiki/Special:AppManagement
# Create it while logged in AS IngeniousBot ("Allow consumer to be used as a bot").
#
# The MW_* names are what this tool has used so far. Toolforge's own pywikibot
# image uses PWB_* names; user-config.py.example accepts either, preferring
# PWB_*, so a later migration needs no code change.

MW_BOT_USERNAME=IngeniousBot

MW_CONSUMER_TOKEN=
MW_CONSUMER_SECRET=
MW_ACCESS_TOKEN=
MW_ACCESS_SECRET=
